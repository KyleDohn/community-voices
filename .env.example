# Required for generating documents and running the A/B judge.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# PORT=3000
# DATABASE_URL=postgres://cv:cv@localhost:5433/community_voices
# 
# Forum to ingest (any public Discourse; check its /tos first)
DISCOURSE_BASE_URL=https://discuss.pixls.us
# Per-run safety caps; four weeks of pixls is ~500 requests and ~600k tokens
INGEST_MAX_REQUESTS=1500
INGEST_MAX_TOKENS=1500000

# Local embedding model; changing it re-embeds everything on next boot (must be 384-d)
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
# Docker sets these two; leave them unset for local dev
# EMBEDDING_CACHE_DIR=
# EMBEDDING_ALLOW_REMOTE=true
