{
  "name": "community-voices",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cv/api --filter @cv/web dev",
    "build": "pnpm --filter @cv/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:model": "vitest run --config vitest.model.config.ts",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:generate": "pnpm --filter @cv/api db:generate",
    "ingest": "pnpm --filter @cv/api ingest",
    "seed:export": "pnpm --filter @cv/api seed:export",
    "prepare": "node .husky/install.mjs",
    "search": "pnpm --filter @cv/api search",
    "retrieve": "pnpm --filter @cv/api retrieve"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
