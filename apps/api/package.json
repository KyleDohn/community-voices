{
  "name": "@cv/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "ingest": "tsx --env-file-if-exists=../../.env src/cli/ingest.ts",
    "seed:export": "tsx --env-file-if-exists=../../.env src/cli/seed-export.ts",
    "search": "tsx --env-file-if-exists=../../.env src/cli/search.ts"
  },
  "dependencies": {
    "@cv/contracts": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@huggingface/transformers": "4.3.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
